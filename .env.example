PORT=3000

# API key gratuita: https://finnhub.io/register
FINNHUB_API_KEY=

# Connection string de Postgres (Supabase: Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Supabase requiere SSL; poner en "false" solo para un Postgres local sin SSL
DATABASE_SSL=true
DATABASE_LOGGING=false

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (tipo "Web application")
GOOGLE_CLIENT_ID=

# Secreto para firmar los JWT propios; genera uno largo y aleatorio, ej: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Origen(es) permitidos para CORS, separados por coma (ej. el dev server de Angular)
CORS_ORIGIN=http://localhost:4200
