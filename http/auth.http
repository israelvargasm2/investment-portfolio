@baseUrl = http://localhost:3000

### Login con Google: pega aquí un ID token real obtenido del frontend
# (Google Identity Services / Sign In With Google) o de la Playground de Google.
# No es un access token de OAuth normal: debe ser el "credential" / id_token con formato JWT.
POST {{baseUrl}}/auth/google
Content-Type: application/json

